# =============================================================================
# Ledger Twin — environment template
# Copy to .env and fill in real values:  cp .env.example .env
# Never commit .env
# =============================================================================

# --- App ---
APP_ENV=development
APP_BASE_URL=http://localhost:8000
# Public URL Stripe/Slack can reach (ngrok / Railway). Required for webhooks.
PUBLIC_BASE_URL=https://YOUR_SUBDOMAIN.ngrok-free.app
PORT=8000

# --- LLM — agent reasoning (OpenAI is the default for this build) ---
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o-mini
# Optional alternatives
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Stripe (Test Mode) ---
# Dashboard → Developers → API keys (Reveal test key)
STRIPE_SECRET_KEY=sk_test_...
# Dashboard → Developers → Webhooks → endpoint signing secret
# Endpoint URL: {PUBLIC_BASE_URL}/webhooks/stripe
# Events: payment_intent.succeeded, invoice.paid
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Airtable (canonical ledger) ---
# https://airtable.com/create/tokens  — scopes: data.records:read/write + schema.bases:read
AIRTABLE_API_KEY=pat...
AIRTABLE_BASE_ID=app...
AIRTABLE_TABLE_CLIENTS=Clients
AIRTABLE_TABLE_INVOICES=Invoices
AIRTABLE_TABLE_PAYMENTS=Payments
AIRTABLE_TABLE_EVENT_LOG=EventLog

# --- Slack (HITL approvals) ---
# api.slack.com/apps → OAuth & Permissions: chat:write
# Interactivity Request URL: {PUBLIC_BASE_URL}/webhooks/slack/interact
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_CHANNEL_ID=C...

# --- Axiom (agent observability / event ingest) ---
# https://app.axiom.co → Settings → API Tokens (ingest permission)
# Create dataset e.g. "ledger-twin"
AXIOM_TOKEN=xaat-...
AXIOM_DATASET=ledger-twin
# Optional: required only if using a personal token instead of API token
AXIOM_ORG_ID=
# Optional region edge (from Axiom ingest curl)
# Example: us-east-1.aws.edge.axiom.co
AXIOM_EDGE=us-east-1.aws.edge.axiom.co

# --- Temp mail (mail.tm) — disposable inbox for payment-email demos/tests ---
# No API key required. Create an account once, then store credentials here.
# Docs: https://docs.mail.tm/
TEMP_MAIL_API_BASE=https://api.mail.tm
TEMP_MAIL_ADDRESS=
TEMP_MAIL_PASSWORD=
# Filled after POST /token (or leave blank and let the app refresh on boot)
TEMP_MAIL_TOKEN=

# --- Gmail (optional polish — receipts / real inbox; temp mail covers demo email path) ---
# Google Cloud Console → enable Gmail API → OAuth desktop/web client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMAIL_USER=me

# --- Local stores ---
SQLITE_PATH=./data/ledger_twin.db
IDEMPOTENCY_DB_PATH=./data/idempotency.db

# --- Agent policy (Strict Match Policy G) ---
ENTITY_AUTO_MATCH_THRESHOLD=90
ENTITY_LLM_BAND_LOW=60
AMOUNT_TOLERANCE_CENTS=1
REQUIRE_EXACT_AMOUNT_FOR_AUTO_CLOSE=true

# --- Eval / demo ---
EVAL_FIXTURES_PATH=./fixtures/eval
DEMO_MODE=true
