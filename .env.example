# Ledger Twin — environment template
# Copy to .env and fill in real values. Never commit secrets.
# Set production secrets in Vercel Project Settings → Environment Variables.

APP_ENV=production
APP_BASE_URL=https://ledger-twin.vercel.app
PUBLIC_BASE_URL=https://ledger-twin.vercel.app
PORT=8000

LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_CLIENTS=Clients
AIRTABLE_TABLE_INVOICES=Invoices
AIRTABLE_TABLE_PAYMENTS=Payments
AIRTABLE_TABLE_EVENT_LOG=EventLog

SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=
SLACK_APP_TOKEN=

# --- Axiom (detailed agent observability) ---
# https://app.axiom.co → API token with ingest (+ query for monthly reports)
AXIOM_TOKEN=
AXIOM_DATASET=ledger-twin
AXIOM_ORG_ID=
AXIOM_EDGE=us-east-1.aws.edge.axiom.co

# --- Temp mail (mail.tm) — INBOUND payment signals only ---
TEMP_MAIL_API_BASE=https://api.mail.tm
TEMP_MAIL_ADDRESS=
TEMP_MAIL_PASSWORD=
TEMP_MAIL_TOKEN=

# --- Monthly report email (1st of each month → previous complete month) ---
# Recipient for the full-month EventLog + temp-mail + Stripe record
REPORT_TO_EMAIL=hamzafarooqsea@gmail.com
REPORT_FROM_EMAIL=Ledger Twin <onboarding@resend.dev>
# Preferred outbound provider: https://resend.com/api-keys
RESEND_API_KEY=
# Or SMTP fallback (e.g. Gmail app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
# Protects POST /cron/monthly-report and POST /reports/monthly/send
CRON_SECRET=

SQLITE_PATH=/tmp/ledger_twin.db
IDEMPOTENCY_DB_PATH=/tmp/idempotency.db

ENTITY_AUTO_MATCH_THRESHOLD=90
ENTITY_LLM_BAND_LOW=60
AMOUNT_TOLERANCE_CENTS=1
REQUIRE_EXACT_AMOUNT_FOR_AUTO_CLOSE=true
DEMO_MODE=true
